# Copy this file to .env and fill in real values before deploying.
# Vite only exposes variables prefixed with VITE_ to client code.

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX).
# Leave unset/placeholder to disable analytics entirely (safe default for dev).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Contact form submission endpoint (e.g. a Formspree/Web3Forms form URL).
# Leave unset to fall back to a plain mailto link.
VITE_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
